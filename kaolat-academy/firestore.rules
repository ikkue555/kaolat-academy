rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /courses/{courseId} {
      // Public read/write so courses sync in real-time across all devices & links
      allow read, write: if true;
    }

    match /sync/{document=**} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
